<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="540.0" prefWidth="1040.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.duoc.maquinaria.controller.MainController">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>

   <!-- ARRIBA: título -->
   <top>
      <Label text="Arriendo de Maquinaria" BorderPane.alignment="CENTER_LEFT">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
         <BorderPane.margin>
            <Insets bottom="12.0" />
         </BorderPane.margin>
      </Label>
   </top>

   <!-- IZQUIERDA: formulario -->
   <left>
      <VBox prefWidth="340.0" spacing="10.0">
         <BorderPane.margin>
            <Insets right="20.0" />
         </BorderPane.margin>
         <children>
            <Label text="Nueva máquina">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="120.0" text="Tipo:" />
                  <ComboBox fx:id="cbTipo" onAction="#onCambiarTipo" prefWidth="190.0" promptText="Seleccione..." />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="120.0" text="Código:" />
                  <TextField fx:id="txtCodigo" prefWidth="190.0" promptText="MAQ-EX01" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="120.0" text="Horas de uso:" />
                  <TextField fx:id="txtHorasUso" prefWidth="190.0" promptText="0 a 20000" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="120.0" text="Potencia (HP):" />
                  <TextField fx:id="txtPotencia" prefWidth="190.0" promptText="Mayor que 0" />
               </children>
            </HBox>

            <!-- Datos de la excavadora -->
            <VBox fx:id="panelExcavadora" spacing="8.0" style="-fx-border-color: #cccccc; -fx-border-radius: 4;">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <Label text="Datos de la excavadora" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label prefWidth="110.0" text="Peso (ton):" />
                        <TextField fx:id="txtPeso" prefWidth="120.0" />
                     </children>
                  </HBox>
                  <CheckBox fx:id="chkMantencion" mnemonicParsing="false" text="Mantención al día" />
                  <CheckBox fx:id="chkCertificacion" mnemonicParsing="false" text="Certificación de seguridad" />
               </children>
            </VBox>

            <!-- Datos del cargador frontal -->
            <VBox fx:id="panelCargador" spacing="8.0" style="-fx-border-color: #cccccc; -fx-border-radius: 4;">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <Label text="Datos del cargador frontal" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label prefWidth="110.0" text="Balde (m³):" />
                        <TextField fx:id="txtCapacidadBalde" prefWidth="120.0" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </left>

   <!-- CENTRO: búsqueda + tabla -->
   <center>
      <VBox spacing="10.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Buscar por código:" />
                  <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="Ej: ex" />
               </children>
            </HBox>
            <TableView fx:id="tablaMaquinas" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colTipo" prefWidth="130.0" text="Tipo" />
                  <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                  <TableColumn fx:id="colHorasUso" prefWidth="105.0" text="Horas de uso" />
                  <TableColumn fx:id="colPotencia" prefWidth="90.0" text="Potencia" />
                  <TableColumn fx:id="colCosto" prefWidth="120.0" text="Costo servicio" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>

   <!-- ABAJO: botones de acción + área de mensajes -->
   <bottom>
      <VBox spacing="10.0">
         <BorderPane.margin>
            <Insets top="12.0" />
         </BorderPane.margin>
         <children>
            <HBox spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onAgregar" prefWidth="100.0" text="Agregar" />
                  <Button mnemonicParsing="false" onAction="#onLimpiar" prefWidth="100.0" text="Limpiar" />
                  <Button mnemonicParsing="false" onAction="#onEliminar" prefWidth="100.0" text="Eliminar" />
               </children>
            </HBox>
            <Label fx:id="lblMensaje" wrapText="true">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </bottom>
</BorderPane>
